# AI IT Incident Classifier
# Example environment variables for local development and Cloud Run.
# Copy this file to .env before running the API locally.

# Application settings
APP_NAME=AI IT Incident Classifier
APP_VERSION=0.1.0
ENVIRONMENT=local

# Classifier provider
# Supported values:
# - mock: uses deterministic local classification rules.
# - gemini: uses Gemini API.
CLASSIFIER_PROVIDER=mock

# BigQuery persistence
# Disabled by default so local tests can run without Google Cloud access.
ENABLE_BIGQUERY_PERSISTENCE=false

# Google Cloud project
# Required when BigQuery persistence or incident history queries are used.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# BigQuery settings
BIGQUERY_DATASET=ai_operations
BIGQUERY_TABLE=incident_classifications

# Gemini API settings
# Required only when CLASSIFIER_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash