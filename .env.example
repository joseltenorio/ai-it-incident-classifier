# AI IT Incident Classifier
# Local / Cloud Run environment variables

# Application settings
APP_NAME=AI IT Incident Classifier
APP_VERSION=0.1.0
ENVIRONMENT=local
LOG_LEVEL=INFO

# Google Cloud project settings
GCP_PROJECT_ID=your-gcp-project-id
GCP_PROJECT_NAME=your-gcp-project-id
GCP_PROJECT_NUMBER=000000000000
GCP_REGION=us-central1
BQ_LOCATION=US

# BigQuery settings
BIGQUERY_DATASET=ai_operations
BIGQUERY_TABLE=incident_classifications

# Gemini API settings
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# API runtime settings
API_HOST=0.0.0.0
API_PORT=8080

# Local development notes
# Copy this file to .env before running the API locally.
# Example:
# cp .env.example .env
#
# Cloud Run notes:
# Configure these values as Cloud Run environment variables.
# Do not commit real API keys or service credentials.