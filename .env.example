# AI IT Incident Classifier
# Example environment variables for local development and deployment commands.
# Copy this file to .env before running the API locally.
# Do not place real secrets in this file.

# Application settings
APP_NAME="AI IT Incident Classifier"
APP_VERSION=0.1.0
ENVIRONMENT=local

# Classifier provider
# Supported values:
# - mock: deterministic local rules.
# - gemini: Gemini API classifier.
CLASSIFIER_PROVIDER=mock

# BigQuery persistence
ENABLE_BIGQUERY_PERSISTENCE=false

# Google Cloud project
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_PROJECT_NUMBER=your-google-cloud-project-number

# BigQuery settings
BIGQUERY_DATASET=ai_operations
BIGQUERY_TABLE=incident_classifications

# Gemini API settings
# Required only when CLASSIFIER_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Deployment settings
REGION=us-central1
ARTIFACT_REPOSITORY=ai-it-incident-classifier
SERVICE_NAME=ai-it-incident-classifier-api
IMAGE_NAME=ai-it-incident-classifier-api
IMAGE_TAG=latest

# Cloud Run runtime service account
RUNTIME_SERVICE_ACCOUNT_NAME=ai-incident-runtime
RUNTIME_SERVICE_ACCOUNT=ai-incident-runtime@ai-it-incident-classifier-jl.iam.gserviceaccount.com
CLOUD_BUILD_EXECUTOR_SA=